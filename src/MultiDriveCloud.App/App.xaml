<Application x:Class="MultiDriveCloud.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:MultiDriveCloud.App.Services"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.Dark.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <svc:BytesConverter x:Key="BytesConv"/>
            <svc:SpeedConverter x:Key="SpeedConv"/>
            <svc:PercentConverter x:Key="PercentConv"/>
            <svc:DateConverter x:Key="DateConv"/>
            <svc:InverseBoolConverter x:Key="InverseBool"/>
            <svc:NullToVisibilityConverter x:Key="NullToVis"/>
            <svc:BoolToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
