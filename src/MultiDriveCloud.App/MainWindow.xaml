<Window x:Class="MultiDriveCloud.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultiDriveCloud.App.ViewModels"
        xmlns:views="clr-namespace:MultiDriveCloud.App.Views"
        Title="MultiDrive Cloud" Width="1280" Height="820" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}" FontFamily="{StaticResource UiFont}"
        Icon="pack://application:,,,/Resources/app.ico" Closing="Window_Closing">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountsViewModel}"><views:AccountsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FilesViewModel}"><views:FilesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransfersViewModel}"><views:TransfersView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="20,24,20,22">
                    <Border Width="34" Height="34" CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4C8DFF" Offset="0"/>
                                <GradientStop Color="#633CDC" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE753;" Style="{StaticResource IconText}" Foreground="White" FontSize="18"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MultiDrive" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="Cloud" Style="{StaticResource MutedText}" FontSize="11" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                 IsChecked="{Binding CurrentKey, Mode=TwoWay, Converter={x:Static views:KeyEquals.Instance}, ConverterParameter=Dashboard}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource IconText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/><TextBlock Text="Tableau de bord"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="Files"
                                 IsChecked="{Binding CurrentKey, Mode=TwoWay, Converter={x:Static views:KeyEquals.Instance}, ConverterParameter=Files}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/><TextBlock Text="Fichiers"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="Transfers"
                                 IsChecked="{Binding CurrentKey, Mode=TwoWay, Converter={x:Static views:KeyEquals.Instance}, ConverterParameter=Transfers}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AB;" Style="{StaticResource IconText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/><TextBlock Text="Transferts"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="Accounts"
                                 IsChecked="{Binding CurrentKey, Mode=TwoWay, Converter={x:Static views:KeyEquals.Instance}, ConverterParameter=Accounts}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" Style="{StaticResource IconText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/><TextBlock Text="Comptes Google"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                 IsChecked="{Binding CurrentKey, Mode=TwoWay, Converter={x:Static views:KeyEquals.Instance}, ConverterParameter=Settings}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource IconText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/><TextBlock Text="Paramètres"/></StackPanel>
                    </RadioButton>
                </StackPanel>

                <Border Grid.Row="2" Margin="14,0,14,16" Padding="12" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12"/>
                        <TextBlock Text="{Binding SpeedText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"
                                   Visibility="{Binding SpeedText, Converter={StaticResource NullToVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentPage}"/>

            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" MaxWidth="720" CornerRadius="10" Padding="16,12"
                    Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35"/></Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="620"/>
                    <Button Content="&#xE711;" Style="{StaticResource IconButton}" Margin="12,-6,-8,-6" Width="28" Height="28" Command="{Binding DismissToastCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
