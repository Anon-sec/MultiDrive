<Window x:Class="MultiDriveCloud.App.Views.FolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choisir un dossier" Width="520" Height="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" FontFamily="{StaticResource UiFont}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="PromptText" FontSize="14" Text="Choisissez le dossier de destination"/>
            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,12,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="&#xE74A;" Style="{StaticResource IconButton}" ToolTip="Dossier parent" Click="Up_Click" Width="30" Height="30"/>
                    <TextBlock x:Name="PathText" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <ListBox x:Name="FolderList" Grid.Row="1" Style="{StaticResource FlatList}" SelectionMode="Single"
                 ItemContainerStyle="{StaticResource FlatListItem}" MouseDoubleClick="FolderList_DoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Annuler" MinWidth="90" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="SelectButton" Content="Choisir ce dossier" Style="{StaticResource AccentButton}" Click="Select_Click"/>
        </StackPanel>
    </Grid>
</Window>
