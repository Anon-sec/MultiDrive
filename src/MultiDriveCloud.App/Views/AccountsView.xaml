<UserControl x:Class="MultiDriveCloud.App.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,36">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Comptes Google" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Chaque compte est indépendant ; leurs espaces libres s'additionnent." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Actualiser les quotas" Command="{Binding RefreshAllCommand}" Margin="0,0,10,0"/>
                    <Button Content="＋  Ajouter un compte Google" Style="{StaticResource AccentButton}" Command="{Binding AddAccountCommand}"
                            IsEnabled="{Binding IsAdding, Converter={StaticResource InverseBool}}"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,22,0,0" BorderBrush="{DynamicResource WarningBrush}"
                    Visibility="{Binding OauthConfigured, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel>
                    <TextBlock Text="Configuration Google en 4 clics (une seule fois)" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,6,0,14"
                               Text="Google exige une « identité » pour toute application qui accède à Drive. Chaque bouton ouvre la bonne page de Google Cloud Console ; revenez ici après chaque étape."/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="1" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="Créer un projet (nom libre, par exemple « MultiDrive Cloud »)"/>
                        <Button Grid.Column="2" Content="Ouvrir" Command="{Binding OpenSetupPageCommand}" CommandParameter="project" MinWidth="110"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="2" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="Activer l'API Google Drive (bouton « Activer »)"/>
                        <Button Grid.Column="2" Content="Ouvrir" Command="{Binding OpenSetupPageCommand}" CommandParameter="api" MinWidth="110"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="3" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Écran de consentement : type « Externe », renseigner nom et e-mail, puis « Publier l'application » (sinon les accès expirent en 7 jours)"/>
                        <Button Grid.Column="2" Content="Ouvrir" Command="{Binding OpenSetupPageCommand}" CommandParameter="consent" MinWidth="110"/>
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="4" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Créer un ID client de type « Application de bureau », puis cliquer sur « Télécharger le JSON »"/>
                        <Button Grid.Column="2" Content="Ouvrir" Command="{Binding OpenSetupPageCommand}" CommandParameter="client" MinWidth="110"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Importer automatiquement le JSON téléchargé" Style="{StaticResource AccentButton}" Command="{Binding AutoImportCommand}" Margin="0,0,8,0"/>
                        <Button Content="Choisir le fichier…" Command="{Binding BrowseImportCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SetupHint}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0" FontSize="12"
                               Visibility="{Binding SetupHint, Converter={StaticResource NullToVis}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,22,0,0" BorderBrush="{DynamicResource AccentBrush}"
                    Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Authentification en cours" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding AddStatus}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,6,60,10"/>
                        <ProgressBar IsIndeterminate="True" Height="4" MaxWidth="400" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Button Content="Annuler" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding CancelAddCommand}"/>
                </Grid>
            </Border>

            <Border Margin="0,22,0,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}">
                <TextBlock TextWrapping="Wrap" FontSize="12" Style="{StaticResource MutedText}"
                           Text="⚠ Les gros fichiers sont répartis sur plusieurs comptes. Si un compte hébergeant un fragment est supprimé, suspendu ou perdu, les fichiers concernés deviennent irrécupérables : MultiDrive Cloud ne duplique pas encore les fragments."/>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="28" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Aucun compte connecté pour le moment." Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
            </Border>

            <ItemsControl ItemsSource="{Binding Cards}" Margin="-8,14,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="470" Margin="8">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource SurfaceAltBrush}">
                                            <TextBlock Text="&#xE753;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentBrush}" FontSize="18"/>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Email}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Ellipse Style="{StaticResource StatusDot}" Tag="{Binding StatusKind}" Margin="0,1,6,0"/>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" Tag="{Binding StatusKind}" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FreeText}" HorizontalAlignment="Right" VerticalAlignment="Top" FontWeight="SemiBold" FontSize="15"/>
                                </Grid>

                                <Grid Height="8" Margin="0,16,0,0">
                                    <ProgressBar Height="8" Value="{Binding UsedFraction}" Foreground="{DynamicResource MutedBrush}"/>
                                    <ProgressBar Height="8" Value="{Binding AppFraction}" Background="Transparent"/>
                                </Grid>
                                <TextBlock Text="{Binding UsedText}" Margin="0,8,0,0" FontSize="12"/>
                                <TextBlock Text="{Binding StoredText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding SyncText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,8,0,0"
                                           Visibility="{Binding Message, Converter={StaticResource NullToVis}}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                                    <Button Content="Actualiser" Margin="0,0,8,0" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <Button Content="Renouveler l'autorisation" Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                                            Visibility="{Binding NeedsReauthorization, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.ReauthorizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <Button Content="Reconnecter" Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                                            Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.ReauthorizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <Button Content="Déconnecter" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                                            Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                            Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <Button Content="Retirer de la liste" Style="{StaticResource DangerButton}"
                                            Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
