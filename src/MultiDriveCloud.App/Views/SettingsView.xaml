<UserControl x:Class="MultiDriveCloud.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MultiDriveCloud.App.Views">
    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="110"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,30,36,24" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Text="Paramètres" Style="{StaticResource PageTitle}"/>

                <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Text="Transferts et fragments" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Transferts simultanés (fichiers)" Style="{StaticResource RowLabel}" Margin="0,0,0,12"/>
                            <TextBox Grid.Column="1" Text="{Binding MaxConcurrentTransfers, UpdateSourceTrigger=LostFocus}" Style="{StaticResource NumberBox}" Margin="0,0,0,12"/>
                            <TextBlock Grid.Row="1" Text="Fragments en parallèle par fichier" Style="{StaticResource RowLabel}" Margin="0,0,0,12"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FragmentParallelism, UpdateSourceTrigger=LostFocus}" Style="{StaticResource NumberBox}" Margin="0,0,0,12"/>
                            <TextBlock Grid.Row="2" Text="Taille maximale d'un fragment (Mo)" Style="{StaticResource RowLabel}" Margin="0,0,0,12"
                                       ToolTip="Un fichier plus petit reste entier s'il tient sur un seul Drive ; sinon il est découpé en fragments de cette taille."/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ChunkSizeMb, UpdateSourceTrigger=LostFocus}" Style="{StaticResource NumberBox}" Margin="0,0,0,12"/>
                            <TextBlock Grid.Row="3" Text="Nouvelles tentatives après erreur réseau" Style="{StaticResource RowLabel}" Margin="0,0,0,12"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaxRetries, UpdateSourceTrigger=LostFocus}" Style="{StaticResource NumberBox}" Margin="0,0,0,12"/>
                            <TextBlock Grid.Row="4" Text="Actualisation automatique des quotas (min)" Style="{StaticResource RowLabel}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding QuotaRefreshMinutes, UpdateSourceTrigger=LostFocus}" Style="{StaticResource NumberBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Répartition automatique" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Vous ne choisissez jamais le compte de destination : le logiciel choisit selon cette stratégie, réserve l'espace pendant le transfert et bascule vers un autre compte si un Drive est plein ou indisponible."/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Stratégie de répartition" Style="{StaticResource RowLabel}" Margin="0,0,0,12"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}" Width="330" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                            <TextBlock Grid.Row="1" Text="Marge de sécurité par compte (Mo)" Style="{StaticResource RowLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SafetyMarginMb, UpdateSourceTrigger=LostFocus}" Style="{StaticResource NumberBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Dossiers et application" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Répertoire de téléchargement" Style="{StaticResource RowLabel}" Margin="0,0,0,12"/>
                            <TextBox Grid.Column="1" Text="{Binding DownloadDirectory}" Margin="0,0,8,12"/>
                            <Button Grid.Column="2" Content="Parcourir…" Command="{Binding BrowseDownloadCommand}" Margin="0,0,0,12"/>
                            <TextBlock Grid.Row="1" Text="Fichiers temporaires" Style="{StaticResource RowLabel}" Margin="0,0,0,12"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TempDirectory}" Margin="0,0,8,12"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="Parcourir…" Command="{Binding BrowseTempCommand}" Margin="0,0,0,12"/>
                            <TextBlock Grid.Row="2" Text="Thème" Style="{StaticResource RowLabel}" Margin="0,0,0,12"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding Theme_}" ItemsSource="{Binding Themes}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                            <TextBlock Grid.Row="3" Text="Notifications" Style="{StaticResource RowLabel}" Margin="0,0,0,12"/>
                            <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding NotificationsEnabled}" Content="Prévenir à la fin ou en cas d'échec d'un transfert" Margin="0,0,0,12"/>
                            <TextBlock Grid.Row="4" Text="Démarrage" Style="{StaticResource RowLabel}"/>
                            <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding StartWithWindows}" Content="Lancer MultiDrive Cloud avec Windows"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Chiffrement facultatif (AES-256-GCM)" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12" TextWrapping="Wrap"
                                   Text="Chaque fragment est chiffré sur votre ordinateur avant l'envoi. La clé est générée aléatoirement et protégée par votre session Windows ; elle n'est jamais écrite dans le code. Perdre la clé = perdre définitivement les fichiers chiffrés : exportez-la."/>
                        <CheckBox IsChecked="{Binding EncryptionEnabled}" Content="Chiffrer les nouveaux envois"/>
                        <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Exporter la clé…" Command="{Binding ExportKeyCommand}" Margin="0,0,8,0"/>
                            <Button Content="Importer une clé…" Command="{Binding ImportKeyCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Google OAuth" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12" TextWrapping="Wrap"
                                   Text="Identifiants de l'application créés dans Google Cloud Console (type « Application de bureau »). Permission demandée : uniquement drive.file (fichiers créés par MultiDrive Cloud). Le secret est protégé par Windows, jamais inclus dans l'exécutable."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Style="{StaticResource StatusDot}" Tag="{Binding OauthOk, Converter={x:Static local:OkToKind.Instance}}"/>
                            <TextBlock Text="{Binding OauthStatus}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="ID client" Style="{StaticResource RowLabel}" Margin="0,0,0,10"/>
                            <TextBox Grid.Column="1" Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="1" Text="Secret client" Style="{StaticResource RowLabel}"/>
                            <PasswordBox x:Name="SecretBox" Grid.Row="1" Grid.Column="1" PasswordChanged="SecretBox_PasswordChanged" ToolTip="Laissez vide pour conserver le secret déjà enregistré"/>
                        </Grid>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="Enregistrer" Style="{StaticResource AccentButton}" Command="{Binding SaveOAuthCommand}" Margin="0,0,8,6"/>
                            <Button Content="Importer le JSON de Google…" Command="{Binding ImportOAuthJsonCommand}" Margin="0,0,8,6"/>
                            <Button Content="Ouvrir Google Cloud Console" Command="{Binding OpenCloudConsoleCommand}" Margin="0,0,8,6"/>
                            <Button Content="Guide de configuration" Command="{Binding OpenOAuthGuideCommand}" Margin="0,0,0,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Sauvegarde et récupération de l'index" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12" TextWrapping="Wrap"
                                   Text="L'index SQLite indique quels fragments de chaque fichier se trouvent sur quel compte. Sans lui, vos fichiers répartis restent sur vos Drive mais ne peuvent plus être reconstitués : sauvegardez-le régulièrement dans un endroit sûr."/>
                        <WrapPanel>
                            <Button Content="Sauvegarder l'index…" Command="{Binding BackupIndexCommand}" Margin="0,0,8,6"/>
                            <Button Content="Restaurer l'index…" Command="{Binding RestoreIndexCommand}" Margin="0,0,8,6"/>
                            <Button Content="Export de récupération (JSON)…" Command="{Binding ExportRecoveryCommand}" Margin="0,0,8,6"/>
                            <Button Content="Ouvrir le dossier de données" Command="{Binding OpenDataFolderCommand}" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding DataFolder}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="36,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Enregistrer les paramètres" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"/>
                <TextBlock Text="{Binding SavedText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
